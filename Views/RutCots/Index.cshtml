@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<RutCot>

@{
    ViewData["Title"] = "Danh sách rút cốt";
    string keyword = Context.Request.Query["search"];

    // Bắt ID cần làm nổi bật từ URL trả về sau khi Thêm/Sửa
    int highlightId = 0;
    if (Context.Request.Query["highlight"].Count > 0)
    {
        int.TryParse(Context.Request.Query["highlight"], out highlightId);
    }
}

<style>
    .rutcot-table th {
        background-color: #212529 !important;
        color: #ffffff;
        font-weight: 600;
        font-size: 14px;
        padding: 10px 8px;
        vertical-align: middle;
    }

    .rutcot-table td {
        font-size: 14px;
        padding: 8px 10px;
        vertical-align: middle;
        white-space: normal;
        word-break: break-word;
    }

    .btn-action-sm {
        padding: 3px 8px;
        font-size: 12px;
        font-weight: 600;
    }

    /* Hiệu ứng bôi màu dòng vừa thao tác */
    .row-highlight td {
        background-color: #d1e7dd !important;
        border-top: 2px solid #198754 !important;
        border-bottom: 2px solid #198754 !important;
        transition: background-color 0.5s ease;
    }
</style>

<div class="container-fluid px-lg-4 my-3">
    <!-- Tiêu đề -->
    <h3 class="text-center fw-bold mb-3 text-uppercase" style="letter-spacing: 0.5px;">
        📦 Danh sách rút cốt
    </h3>

    <!-- Thanh công cụ: Tìm kiếm, Thêm mới, Xuất Excel gom chung 1 hàng -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <!-- Cụm tìm kiếm -->
        <form asp-action="Index" method="get" class="d-flex align-items-center" style="max-width: 420px; flex: 1;">
            <div class="input-group input-group-sm">
                <input type="text" name="search" value="@keyword" class="form-control" placeholder="Tìm theo ID hoặc tên người rút..." />
                <button type="submit" class="btn btn-primary px-3 fw-bold">Tìm</button>
            </div>
            @if (!string.IsNullOrEmpty(keyword))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-2 text-nowrap">Hủy</a>
            }
        </form>

        <!-- Cụm nút thao tác xuất/nhập -->
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-sm btn-success fw-bold px-3">
                ➕ Thêm mới
            </a>
            <a asp-action="ExportExcel" asp-route-search="@keyword" class="btn btn-sm btn-outline-success fw-bold px-3">
                📥 Xuất Excel
            </a>
        </div>
    </div>

    <!-- Bảng dữ liệu cân đối, có viền bo góc và bóng nhẹ -->
    <div class="table-responsive rounded shadow-sm border bg-white">
        <table class="table table-bordered table-hover table-striped mb-0 rutcot-table align-middle">
            <thead class="text-center">
                <tr>
                    <th style="width: 50px;">ID</th>
                    <th style="width: 150px;" class="text-start">Người Rút</th>
                    <th style="width: 80px;">Năm Sinh</th>
                    <th style="width: 110px;">SĐT</th>
                    <th class="text-start">Địa Chỉ</th>
                    <th style="width: 180px;" class="text-start">Họ Tên Cốt</th>
                    <th style="width: 70px;">Lô</th>
                    <th style="width: 60px;">Lầu</th>
                    <th style="width: 100px;">Ngày Rút</th>
                    <th style="width: 180px;" class="text-start">Lý Do Rút</th>
                    <th style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <!-- Gắn ID và Class vào thẻ tr để javascript tìm tới và đổi màu -->
                        <tr id="rutcot-@item.IDRut" class="@(item.IDRut == highlightId ? "row-highlight" : "")">
                            <td class="text-center fw-bold text-secondary">@item.IDRut</td>

                            <!-- Các cột thông tin đã được tách rời -->
                            <td class="text-start fw-bold text-primary">
                                @($"{item.HoNguoiRut} {item.TenNguoiRut}".Trim())
                            </td>
                            <td class="text-center">
                                @item.NamSinhNguoiRut
                            </td>
                            <td class="text-center">
                                @item.SDT
                            </td>
                            <td class="text-start text-muted">
                                @item.DiaChi
                            </td>

                            <td class="text-start text-dark">
                                @Html.Raw(item.HoTenCot?.Replace("\n", "<br/>"))
                            </td>
                            <td class="text-center fw-bold text-primary">
                                @Html.Raw(item.Lo?.Replace("\n", "<br/>"))
                            </td>
                            <td class="text-center">
                                @Html.Raw(item.Lau?.Replace("\n", "<br/>"))
                            </td>
                            <td class="text-center text-muted">
                                @{
                                    string ngayHienThi = item.NgayRut ?? "";
                                    if (double.TryParse(item.NgayRut, out double oaDate))
                                    {
                                        try
                                        {
                                            ngayHienThi = DateTime.FromOADate(oaDate).ToString("dd/MM/yyyy");
                                        }
                                        catch { }
                                    }
                                }
                                @ngayHienThi
                            </td>
                            <td class="text-start text-muted">
                                @Html.Raw(item.LyDo?.Replace("\n", "<br/>"))
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@item.IDRut" class="btn btn-info text-white btn-action-sm">
                                        Chi tiết
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IDRut" class="btn btn-warning text-dark btn-action-sm">
                                        Cập nhật
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11" class="text-center py-4 text-muted">Không có dữ liệu rút cốt.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Thanh tổng cộng và phân trang -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 small text-muted">
        <div>
            Tổng cộng: <strong>@Model.TotalItemCount</strong> phiếu rút cốt
        </div>
        <div>
            @Html.PagedListPager(Model, page => Url.Action("Index", new { page, search = keyword }),
                     new PagedListRenderOptions
            {
                MaximumPageNumbersToDisplay = 5,
                UlElementClasses = new[] { "pagination pagination-sm mb-0" },
                LiElementClasses = new[] { "page-item" },
                PageClasses = new[] { "page-link" }
            })
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lắng nghe sự kiện load trang để cuộn đến dòng vừa thao tác
        window.addEventListener("load", function () {
            const urlParams = new URLSearchParams(window.location.search);
            const highlightId = urlParams.get("highlight");

            if (highlightId) {
                const targetRow = document.getElementById("rutcot-" + highlightId);
                if (targetRow) {
                    setTimeout(() => {
                        // Trượt màn hình nhẹ nhàng xuống giữa dòng được chọn
                        targetRow.scrollIntoView({ behavior: "smooth", block: "center" });
                    }, 400); // Trì hoãn một chút để đảm bảo giao diện đã render xong
                }
            }
        });
    </script>
}