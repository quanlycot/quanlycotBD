@model QuanLyCotWeb.Models.Cot

@{
    ViewData["Title"] = "Chi tiết Tro Cốt - " + Model.Ho + " " + Model.Ten;
    bool isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    Layout = isAjax ? null : "_Layout";
}

<style>
    .bg-details-container {
        background-image: linear-gradient(rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.88)), url('/images/bg-cot.jpg');
        background-size: cover;
        background-position: center top;
        background-attachment: fixed;
        min-height: calc(100vh - 280px);
        padding: 40px 15px 60px 15px;
    }

    .serif-title {
        font-family: 'Merriweather', serif;
    }

    .detail-card-main {
        background: #0d0b09 !important;
        border: 2px solid #b45309;
        border-radius: 24px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.95);
        color: #ffffff;
    }

    /* Triệt tiêu hoàn toàn nền trắng của table */
    .table-details-inner {
        --bs-table-bg: transparent !important;
        background-color: transparent !important;
        color: #ffffff !important;
        margin-bottom: 0;
    }

        .table-details-inner tbody,
        .table-details-inner tr,
        .table-details-inner th,
        .table-details-inner td {
            background-color: transparent !important;
            border-color: rgba(255, 255, 255, 0.1) !important;
        }

        .table-details-inner th {
            color: #a8a29e !important;
            font-weight: 500;
            font-size: 14px;
            width: 170px;
            padding: 10px 8px;
        }

        .table-details-inner td {
            color: #ffffff !important;
            font-weight: 600;
            font-size: 15px;
            padding: 10px 8px;
        }
</style>

<div class="@(isAjax ? "" : "bg-details-container")">
    <div class="@(isAjax ? "" : "container")" style="max-width: 950px; margin: auto;">

        <div class="card p-4 p-md-5 detail-card-main">

            <!-- Tiêu đề hồ sơ -->
            <div class="d-flex justify-content-between align-items-center border-bottom border-warning pb-3 mb-4">
                <h3 class="serif-title fw-bold text-warning mb-0 fs-4">
                    🏺 HỒ SƠ LƯU TRỮ TRO CỐT
                </h3>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold px-3 py-2 rounded-pill">
                        Mã cốt: #@Model.Idcot
                    </span>
                    @if (isAjax)
                    {
                        <button type="button" onclick="dongChiTietTang3()" class="btn btn-sm btn-dark text-stone-300 border border-secondary px-3 py-1">
                            ✕ Đóng lại
                        </button>
                    }
                </div>
            </div>

            <div class="row g-4 align-items-start">

                <!-- Cột ảnh: Lồng viền hoa văn Nen.PNG + Nút xem thêm ảnh (chỉ hiện khi có link) -->
                <div class="col-12 col-md-5 text-center">
                    <div class="position-relative mx-auto rounded-3 overflow-hidden border border-secondary shadow-lg" style="max-width: 250px;">
                        <img src="@(!string.IsNullOrEmpty(Model.HinhNguoiMat)
                                     ? $"{Model.HinhNguoiMat}?ver={Guid.NewGuid()}"
                                     : Url.Content("~/images/anhcot.jpg"))"
                             alt="Ảnh người mất"
                             class="img-fluid"
                             style="width: 100%; height: auto; object-fit: cover; display: block;" />

                        <img src="~/images/Nen.PNG"
                             alt="Khung hoa văn"
                             class="position-absolute top-0 start-0"
                             style="width: 100%; height: 100%; pointer-events: none;" />
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.LinkAnh))
                    {
                        <div class="mt-3">
                            <a href="@Model.LinkAnh" target="_blank" rel="noopener noreferrer"
                               class="btn btn-primary btn-sm fw-bold px-4 py-2 rounded-3 shadow" style="background-color: #2563eb; border-color: #2563eb;">
                                📷 Xem Thêm Ảnh
                            </a>
                        </div>
                    }
                </div>

                <!-- Cột thông tin: Nền đen mun -->
                <div class="col-12 col-md-7">
                    <div class="p-3 rounded-3 border border-secondary-subtle" style="background-color: #14110e !important;">
                        <table class="table table-borderless table-details-inner">
                            <tbody>
                                <tr>
                                    <th>Họ và Tên:</th>
                                    <td class="text-warning text-uppercase fs-5 fw-bold">
                                        @($"{Model.Ho} {Model.Ten}".Trim())
                                    </td>
                                </tr>
                                <tr>
                                    <th>Pháp danh:</th>
                                    <td>@(!string.IsNullOrEmpty(Model.PhapDanh) ? Model.PhapDanh : "Chưa có")</td>
                                </tr>
                                <tr>
                                    <th>Năm sinh:</th>
                                    <td>@(Model.NamSinh ?? "---")</td>
                                </tr>
                                <tr>
                                    <th>Ngày mất (ÂL):</th>
                                    <td class="text-warning-emphasis">@(Model.MatAl ?? "---")</td>
                                </tr>
                                <tr>
                                    <th>Ngày mất (DL):</th>
                                    <td>@(Model.MatDl ?? "---")</td>
                                </tr>
                                <tr>
                                    <th>Hưởng thọ:</th>
                                    <td>@(Model.Tuoi.HasValue ? $"{Model.Tuoi} tuổi" : "---")</td>
                                </tr>
                                <tr>
                                    <th>Ngày bắt đầu:</th>
                                    <td>@Model.NgayBatDau?.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Ngày kết thúc:</th>
                                    <td>@Model.NgayKetThuc?.ToString("dd/MM/yyyy")</td>
                                </tr>
                                <tr>
                                    <th>Vị trí an vị:</th>
                                    <td class="text-warning fw-bold">
                                        📍 Lầu @Model.IdViTriNavigation?.Lau - Dãy @Model.IdViTriNavigation?.LoSo
                                    </td>
                                </tr>
                                <tr>
                                    <th>Người thân:</th>
                                    <td>
                                        @if (Model.IdnguoiThanNavigation == null)
                                        {
                                            <span class="text-danger fw-semibold">Chưa đăng ký người thân</span>
                                        }
                                        else if (Model.IdnguoiThanNavigation.Ho == "trong" || Model.IdnguoiThanNavigation.Ten == "trong")
                                        {
                                            <span class="text-danger fw-semibold">Gia đình vui lòng liên hệ Chùa đăng ký lại thông tin cốt</span>
                                        }
                                        else
                                        {
                                            <span>@($"{Model.IdnguoiThanNavigation.Ho} {Model.IdnguoiThanNavigation.Ten}".Trim())</span>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Cụm nút nghiệp vụ: Bổ sung Zalo, Đặt Mâm Cúng, Đặt Hoa -->
                    <div class="d-flex flex-wrap gap-2 mt-4">
                        @if (isAjax)
                        {
                            <button type="button" onclick="dongChiTietTang3()" class="btn btn-secondary px-4 fw-bold">
                                Quay lại
                            </button>
                        }
                        else
                        {
                            <a href="javascript:history.back()" class="btn btn-secondary px-4 fw-bold">
                                Quay lại
                            </a>
                        }

                        <a href="https://zalo.me/0703676073" target="_blank" rel="noopener noreferrer"
                           class="btn fw-bold px-4 shadow text-white" style="background-color: #0068ff; border-color: #0068ff;">
                            💬 Bổ Sung Thông Tin
                        </a>

                        <a href="http://chuabuuda.org/vn/dat-mam-cung.html" target="_blank"
                           class="btn btn-warning text-dark px-4 fw-bold shadow" style="background-color: #f59e0b; border-color: #f59e0b;">
                            Đặt Mâm Cúng
                        </a>
                        <a href="https://chuabuuda.org/vn/dat-hoa.html" target="_blank"
                           class="btn btn-success px-4 fw-bold shadow" style="background-color: #10b981; border-color: #10b981;">
                            Đặt Hoa - Gửi Hoa
                        </a>
                    </div>

                </div>
            </div>

        </div>

    </div>
</div>